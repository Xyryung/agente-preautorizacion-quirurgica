# Copia este archivo como .env y rellena los valores reales.
# .env esta en .gitignore: nunca lo subas al repositorio.
# En Render, estas mismas variables se configuran en Environment.

# --- Notion ---
NOTION_TOKEN=
NOTION_DB_INFORMES=
NOTION_DB_POLIZAS=
NOTION_DB_RESOLUCIONES=
# Se obtiene en el handshake del webhook (issue de webhook)
NOTION_WEBHOOK_VERIFICATION_TOKEN=

# --- IA ---
# Proveedor de extraccion: openai | ollama | regex
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Verifica en tu cuenta de OpenAI que el modelo este disponible
OPENAI_MODEL=gpt-5-mini
# Solo para desarrollo local con Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- Demo publica ---
# Token simple para proteger endpoints que escriben en Notion
DEMO_ADMIN_TOKEN=
